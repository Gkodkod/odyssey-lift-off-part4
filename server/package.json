{
  "name": "catstronauts-server",
  "version": "1.0.0",
  "description": "back-end demo app for Apollo's lift-off IV course",
  "main": "src/index.js",
  "scripts": {
    "postinstall": "npm run generate",
    "compile": "tsc",
    "dev": "ts-node-dev --respawn ./src/index.ts",
    "start": "npm run compile && nodemon ./dist/index.js",
    "generate": "graphql-codegen"
  },
  "dependencies": {
    "@apollo/datasource-rest": "^5.0.2",
    "@apollo/server": "^4.5.0",
    "@as-integrations/fastify": "^3.1.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@graphql-tools/schema": "^10.0.33",
    "@scalar/client-side-rendering": "^0.1.6",
    "@scalar/express-api-reference": "^0.9.13",
    "@thoughtspot/graph-to-openapi": "^0.9.3",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "fastify": "^5.8.5",
    "graphql": "^16.13.2",
    "graphql-tag": "^2.12.6",
    "graphql-to-openapi": "^3.0.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^4.0.1",
    "@graphql-codegen/typescript": "^4.0.1",
    "@graphql-codegen/typescript-resolvers": "^4.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
